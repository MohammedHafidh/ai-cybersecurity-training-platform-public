{
  "name": "ai-cybersecurity-training-platform-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "api:generate": "python ../scripts/export_frontend_openapi.py && openapi-typescript .openapi.generated.json -o src/api/schema.d.ts",
    "api:check": "python ../scripts/export_frontend_openapi.py && openapi-typescript .openapi.generated.json -o src/api/schema.d.ts --check",
    "test": "node --experimental-strip-types --test tests/*.test.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "openapi-typescript": "7.13.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  }
}
